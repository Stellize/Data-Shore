# Data Shore hub — the public site and console.
# Build from the repository root:  docker build -f Dockerfile.hub -t data-shore-hub .
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/hub/package.json apps/hub/package.json
COPY apps/node/package.json apps/node/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --no-audit --no-fund
COPY packages/shared packages/shared
COPY apps/web apps/web
COPY apps/hub apps/hub
RUN npm run build
RUN npm prune --omit=dev

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8787 \
    DATA_SHORE_HUB_DATA=/data \
    DATA_SHORE_WEB_DIR=/app/apps/web/dist
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/packages packages
COPY --from=build /app/apps/hub apps/hub
COPY --from=build /app/apps/web/dist apps/web/dist
RUN mkdir -p /data && chown -R node:node /data
USER node
EXPOSE 8787
VOLUME ["/data"]
CMD ["node", "apps/hub/src/index.js"]
